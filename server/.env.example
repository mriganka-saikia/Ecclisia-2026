# --- Required in production ---
JWT_SECRET=change-me-to-a-long-random-string
COLLEGE_EMAIL_DOMAIN=college.edu
# ^ comma-separate for several, e.g. xyz.ac.in,xyz.edu

# --- Database ---
# Leave DATABASE_URL empty to run on an embedded Postgres (PGlite) with zero setup.
# For Supabase paste the connection string (Settings > Database > Connection pooling).
DATABASE_URL=

# --- AI semantic search (optional; keyword search is the automatic fallback) ---
LLM_PROVIDER=gemini
LLM_API_KEY=

# --- Email OTP (optional; without SMTP the code is printed in the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TimeBank <no-reply@timebank.app>

# --- Tuning ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
CAMPUS_TZ_OFFSET_MIN=330
DAILY_EARN_CAP_HOURS=4
WELCOME_CREDITS_HOURS=3
# Settlement windows, counted from the end of a session
AUTO_RELEASE_HOURS=48
AUTO_REFUND_HOURS=72
DISPUTE_RESOLVE_DAYS=7
# true: sessions can be confirmed before they end and the OTP is returned by the API (demo/dev only)
DEMO_MODE=true
# true: fill an empty database with demo students, skills and ledger history on startup
AUTO_SEED=true
# Postgres schema TimeBank lives in (created automatically; keeps it separate from any other tables)
DB_SCHEMA=timebank
